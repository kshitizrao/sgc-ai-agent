{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SGC Agent Webhook Event",
  "type": "object",
  "required": ["event_type", "session_id", "data"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["emergency_logged", "human_review_required", "booking_requested", "claim_intimation"]
    },
    "session_id": { "type": "string" },
    "data": { "type": "object" }
  }
}
